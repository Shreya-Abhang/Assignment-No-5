<?php
$file = fopen("contact.dat", "r");
echo "<table border=1 cellpadding='8'>";
echo "<tr>";
echo "<th>Sr No</th>";
echo "<th>Name</th>";
echo "<th>Residence Number</th>";
echo "<th>Mobile Number</th>";
echo "<th>Address</th>";
echo "</tr>";

while (($line = fgets($file)) !== false) {
    $data = explode(", ", trim($line));
    echo "<tr>";
    echo "<td>" . $data[0] . "</td>";
    echo "<td>" . $data[1] . "</td>";
    echo "<td>" . $data[2] . "</td>";
    echo "<td>" . $data[3] . "</td>";
    echo "<td>" . $data[4] . "</td>";
    echo "</tr>";
}
echo "</table>";
fclose($file);
?>

<html>
<body>
    <script type="text/javascript">
        function display() {
            var x = new XMLHttpRequest();
            x.open("GET", "geta1.php", true);
            x.send();
            x.onreadystatechange = function() {
                if (x.readyState == 4 && x.status == 200) {
                    document.getElementById("show").innerHTML = x.responseText;
                }
            };
        }
    </script>

    <h2>Contact Details</h2>
    <button onclick="display()">Print</button><br><br>
    <div id="show"></div>
</body>
</html>
