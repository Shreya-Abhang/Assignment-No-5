$name = $_GET['name'];
$con = pg_connect("host=localhost dbname=College user=root");

$qry = "select ono, date, shipping_address from Customer, orders where Customer.cno = orders.cno and cname = '$name'";
$res = pg_query($con, $qry);

if ($res) {
    echo "<table border='1'>";
    echo "<tr>
            <th>Order no</th>
            <th>Order date</th>
            <th>Shipping Address</th>
          </tr>";

    while ($row = pg_fetch_row($res)) {
        echo "<tr>";
        echo "<td>" . $row[0] . "</td>";
        echo "<td>" . $row[1] . "</td>";
        echo "<td>" . $row[2] . "</td>";
        echo "</tr>";
    }
    echo "</table>";
}
